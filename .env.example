# Configuration Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Clé secrète (CHANGER EN PRODUCTION)
SECRET_KEY=change-this-secret-key-in-production-cosmitto-2024

# Base de données
# SQLite (par défaut)
DATABASE_URL=sqlite:///instance/cosmitto.db

# PostgreSQL (optionnel)
# DATABASE_URL=postgresql://username:password@localhost:5432/cosmittodesk

# MySQL (optionnel)
# DATABASE_URL=mysql://username:password@localhost:3306/cosmittodesk

# Upload de fichiers
UPLOAD_FOLDER=static/uploads
MAX_UPLOAD_SIZE=52428800

# Email (optionnel)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@cosmitto.com

# Autres paramètres
TIMEZONE=Africa/Tunis
LANGUAGE=fr
